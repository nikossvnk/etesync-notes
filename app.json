{
  "expo": {
    "name": "EteSync Notes",
    "slug": "etesync_notes",
    "version": "2.0.3",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#424242"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "web": {
      "favicon": "./assets/favicon.png",
      "themeColor": "#ffc107"
    },
    "android": {
      "package": "com.etesync.notes",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#424242"
      }
    },
    "platforms": [
      "android",
      "web"
    ],
    "plugins": [
      "expo-secure-store"
    ]
  }
}
